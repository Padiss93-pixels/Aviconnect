{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "AviConnect Web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--clear"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "AviConnect Static",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/serve-dist.js"],
      "port": 4173
    },
    {
      "name": "AviConnect Expo",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--tunnel"],
      "port": 8081,
      "autoPort": true
    }
  ]
}

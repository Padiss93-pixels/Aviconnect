{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "build": {
    "env": {
      "EXPO_PUBLIC_SUPABASE_URL": "https://ctnmflsyueqtwvhcksqz.supabase.co",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN0bm1mbHN5dWVxdHd2aGNrc3F6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ1NTkyNjcsImV4cCI6MjEwMDEzNTI2N30.RDOp98Md43CF3HVV17PosQCkoT3Rtmgnvs19Cypl4GE"
    }
  },
  "rewrites": [
    { "source": "/lot/:id", "destination": "/lot/[id].html" },
    { "source": "/vendeur/:id", "destination": "/vendeur/[id].html" },
    { "source": "/veterinaire/:id", "destination": "/veterinaire/[id].html" },
    { "source": "/couvoir/:id", "destination": "/couvoir/[id].html" },
    { "source": "/chat/:id", "destination": "/chat/[id].html" },
    { "source": "/commander/:id", "destination": "/commander/[id].html" },
    { "source": "/modifier-annonce/:id", "destination": "/modifier-annonce/[id].html" },
    { "source": "/boost/:id", "destination": "/boost/[id].html" },
    { "source": "/actualites/:id", "destination": "/actualites/[id].html" },
    { "source": "/((?!_expo|assets|legal|favicon|robots|sitemap).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
